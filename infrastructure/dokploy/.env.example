# Variáveis do Integration AI Doctor no Dokploy (aba Environment do serviço Compose).
# Cada valor aparece uma vez: o compose deriva NEXT_PUBLIC_*, SUPABASE_JWT_ISSUER e o redirect do Jira.
# Detalhes e como gerar cada segredo: docs/operations/dokploy.md.

# --- Supabase (projeto compartilhado com o jayv-coder, ADR-0009) ---
SUPABASE_URL=https://exvsozyemolrjbjetqww.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_7PeIEX0yh_svIEeNw3Gwew_lEbMVtMm
# Segredos (Dashboard → Settings): pooler de transações (porta 6543) e a secret key.
SUPABASE_DB_URL=postgresql://postgres.exvsozyemolrjbjetqww:<SENHA>@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
SUPABASE_SERVICE_ROLE_KEY=

# --- Endereços públicos (os domínios do Dokploy, sem barra no fim) ---
APP_URL=https://doctor.seu-dominio.com
API_PUBLIC_URL=https://api.doctor.seu-dominio.com

# --- E-mail (convites, alertas e avisos) ---
SMTP_URL=smtp://usuario:senha@smtp.seu-provedor.com:587
MAIL_FROM=

# --- Segredos gerados para este ambiente ---
HMAC_MASTER_KEY=

# --- IA (opcional: sem as chaves, o Diagnóstico sai só com as Regras e a Base busca pelo texto) ---
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
LLM_ROUTING={}
LLM_PRICES=

# --- Push no PWA (opcional) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:alertas@jayv.dev

# --- Jira (opcional, #43) ---
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=

# --- Agente local (opcional, #39: certificado mTLS emitido no registro) ---
AGENT_CA_KEY=
AGENT_CA_CERT=

# --- Ajustes (padrões já servem) ---
GCP_PROJECT_ID=aid-local
LOG_LEVEL=INFO
RATE_LIMIT_PER_MINUTE=120
