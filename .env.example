# Copie para .env e ajuste. Nenhum valor aqui é segredo real.
# Supabase local (preenchidos por `supabase start`, ticket #2)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Web (Next.js). Valores da stack local: `supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
API_URL=http://127.0.0.1:8000

# Google OAuth (opcional localmente; ver supabase/config.toml)
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# API: emissor dos JWTs do Supabase (JWKS em <issuer>/.well-known/jwks.json)
SUPABASE_JWT_ISSUER=http://127.0.0.1:54321/auth/v1
