          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": ["token"],
        "title": "Acceptance"
      },
      "AcceptedInvitation": {
        "properties": {
          "tenant_id": {
            "type": "string",
            "title": "Tenant Id"
          }
        },
        "type": "object",
        "required": ["tenant_id"],
