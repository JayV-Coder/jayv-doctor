              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Invitation": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "email": {
            "type": "string",
            "title": "Email"
          },
          "role": {
            "type": "string",
            "title": "Role"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "title": "Expires At"
          }
        },
        "type": "object",
        "required": ["id", "email", "role", "expires_at"],
        "title": "Invitation"
      },
      "Me": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email"
          },
          "aal": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Aal"
          },
          "profile": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Profile"
              },
              {
                "type": "null"
              }
            ]
          },
          "organizations": {
            "items": {
              "$ref": "#/components/schemas/Organization"
            },
            "type": "array",
            "title": "Organizations"
          },
          "active_tenant_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Active Tenant Id"
          },
          "active_role": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Active Role"
          }
        },
        "type": "object",
        "required": [
          "id",
          "email",
          "aal",
          "profile",
          "organizations",
          "active_tenant_id",
          "active_role"
        ],
        "title": "Me"
      },
      "Member": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "display_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Display Name"
          },
          "email": {
            "type": "string",
            "title": "Email"
          },
          "role": {
            "type": "string",
            "title": "Role"
          },
          "mfa_enabled": {
            "type": "boolean",
            "title": "Mfa Enabled"
          }
        },
        "type": "object",
        "required": ["id", "display_name", "email", "role", "mfa_enabled"],
        "title": "Member"
      },
      "NewInvitation": {
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "pattern": "^[^@\\s]+@[^@\\s]+$",
            "title": "Email"
          },
          "role": {
            "type": "string",
            "enum": ["owner", "admin", "analyst", "viewer"],
            "title": "Role"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": ["email", "role"],
        "title": "NewInvitation"
      },
      "NewOrganization": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 80,
            "minLength": 2,
            "title": "Name"
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{1,38}[a-z0-9]$",
            "title": "Slug"
          },
          "segment": {
            "type": "string",
            "maxLength": 80,
            "minLength": 2,
            "title": "Segment"
          },
          "llm_provider": {
            "type": "string",
            "enum": ["anthropic", "vertex"],
            "title": "Llm Provider"
          },
          "dpa_accepted": {
            "type": "boolean",
            "const": true,
            "title": "Dpa Accepted"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": ["name", "slug", "segment", "llm_provider", "dpa_accepted"],
        "title": "NewOrganization"
      },
      "Organization": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "slug": {
            "type": "string",
            "title": "Slug"
          },
          "role": {
            "type": "string",
            "title": "Role"
          }
        },
        "type": "object",
        "required": ["id", "name", "slug", "role"],
        "title": "Organization"
      },
      "Profile": {
        "properties": {
          "full_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Full Name"
          },
          "avatar_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Avatar Url"
          },
          "locale": {
            "type": "string",
            "title": "Locale"
          }
        },
        "type": "object",
        "required": ["full_name", "avatar_url", "locale"],
        "title": "Profile"
      },
      "RoleChange": {
        "properties": {
          "role": {
            "type": "string",
            "enum": ["owner", "admin", "analyst", "viewer"],
            "title": "Role"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": ["role"],
        "title": "RoleChange"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
