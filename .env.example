# Stack local (desenvolvimento). Copie para .env e preencha com `supabase status`.
# Nenhum valor aqui é segredo real. Para o Dokploy, use infrastructure/dokploy/.env.example.
#
# Alguns valores aparecem duas vezes de propósito: a web (Next.js) só enxerga no navegador o que
# começa com NEXT_PUBLIC_, e a API e os workers leem os nomes sem prefixo. Mantenha os pares iguais:
#   SUPABASE_URL             = NEXT_PUBLIC_SUPABASE_URL
#   SUPABASE_PUBLISHABLE_KEY = NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
#   APP_URL                  = NEXT_PUBLIC_SITE_URL
#   SUPABASE_JWT_ISSUER      = SUPABASE_URL + /auth/v1

# API e workers
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_JWT_ISSUER=http://127.0.0.1:54321/auth/v1
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
APP_URL=http://127.0.0.1:3000
# E-mail (Mailpit da stack local)
SMTP_URL=smtp://127.0.0.1:54325

# Web (Next.js)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
API_URL=http://127.0.0.1:8000

# Supabase CLI: Google OAuth local (opcional, lido pelo supabase/config.toml)
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
